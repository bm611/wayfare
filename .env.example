VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server side only — read by the trip-cover background function, never by the
# browser. Set it on Netlify, not with a VITE_ prefix.
TOGETHER_API_KEY=

# Android only — the *web* OAuth client id from Google Cloud, i.e. the same one pasted
# into Supabase's Google provider. Leave it blank and the app skips the native Google
# sheet and signs in through the browser instead. Can also live in android/local.properties.
GOOGLE_WEB_CLIENT_ID=
